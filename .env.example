# Copy to .env for running outside Docker (npm run dev / npm run worker / npm test).
# docker compose sets its own values and does not need this file.

# Main database used by the app, the worker and the seed script
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/newtonite"

# Separate database used only by `npm test`. Its name MUST end in _test (tests truncate it).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/newtonite_test"

# Secret used to sign session JWTs. Use a long random value (32+ chars) outside local dev.
JWT_SECRET="replace-me-with-a-long-random-string-32-chars-min"

# Set to "true" when serving over HTTPS so the session cookie gets the Secure flag.
COOKIE_SECURE="false"
